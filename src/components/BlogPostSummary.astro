---
const { blogPost, linkToBlog } = Astro.props;
---

<div class="blog-posts-preview">
    <div>

    {
        linkToBlog ? (
            <h1 class="blog-post-title"><a href={`/blog/${blogPost.slug}`}>{blogPost.data.title}</a></h1>

        ) : (
            <h1 class="blog-post-title">{blogPost.data.title}</h1>

        )
    }
        

            
    <span class="blog-post-date">
        {new Date(blogPost.data.date).toLocaleDateString()}
    </span>

    {blogPost.data.tags.map(tag => (
        <span class="blog-post-tags">{tag + " "}</span>
    ))}
               
    <div class="blog-post-description">

               
    {
        linkToBlog ? (

            <h3>
                {blogPost.data.description}{" "}
                    <a class="read-more" href={`/blog/${blogPost.slug}`}>
                    Read more...
                    </a>
            </h3>
        ) : (

            <h3>
                {blogPost.data.description}{" "}
            </h3>

        )
        }        

       </div>

<style> 


.blog-posts-preview {
    /* border:  2px solid  var(--brand);*/
    border-radius: .5em; 
    padding: 10px 10px 10px 10px; 
    background-color: var(--bg-col-fade);
}
.blog-post-title {
    margin-top: 0;
}
.blog-post-date {
    font-size: calc(var(--text-size) * .7);
}

.blog-post-tags {
  padding: 3px 6px 3px 6px;
  border-radius: 4px;
  border: 1px solid var(--brand);
  text-decoration: none;
  font-size: calc(var(--text-size) * .7 );
  margin-right: calc(var(--text-size) * .3);
}

.blog-post-description {
    margin-top: .3rem;
    line-height: 1.2; 
}

@media (max-width: 600px) {
.container {
    grid-template-columns: 1fr;
}
}
</style>

